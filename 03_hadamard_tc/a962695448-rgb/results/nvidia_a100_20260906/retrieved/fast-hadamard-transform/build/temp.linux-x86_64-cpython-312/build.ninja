ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-12.4/bin/nvcc

cflags = -pthread -B /home/vipuser/miniconda3/compiler_compat -fno-strict-overflow -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/vipuser/miniconda3/include -fPIC -O2 -isystem /home/vipuser/miniconda3/include -fPIC -I/home/vipuser/infinitensor-2026/hadamard-cuda-a100/fast-hadamard-transform -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include/TH -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include/THC -I/usr/local/cuda-12.4/include -I/home/vipuser/infinitensor-2026/hadamard-cuda-a100/.venv/include -I/home/vipuser/miniconda3/include/python3.12 -c
post_cflags = -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=fast_hadamard_transform_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/vipuser/infinitensor-2026/hadamard-cuda-a100/fast-hadamard-transform -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include/TH -I/home/vipuser/miniconda3/lib/python3.12/site-packages/torch/include/THC -I/usr/local/cuda-12.4/include -I/home/vipuser/infinitensor-2026/hadamard-cuda-a100/.venv/include -I/home/vipuser/miniconda3/include/python3.12 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_BFLOAT16_OPERATORS__ -U__CUDA_NO_BFLOAT16_CONVERSIONS__ -U__CUDA_NO_BFLOAT162_OPERATORS__ -U__CUDA_NO_BFLOAT162_CONVERSIONS__ --expt-relaxed-constexpr --expt-extended-lambda --use_fast_math --ptxas-options=-v -lineinfo --threads 1 -gencode arch=compute_75,code=sm_75 -gencode arch=compute_80,code=sm_80 -gencode arch=compute_87,code=sm_87 -gencode arch=compute_90,code=sm_90 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=fast_hadamard_transform_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/vipuser/infinitensor-2026/hadamard-cuda-a100/fast-hadamard-transform/build/temp.linux-x86_64-cpython-312/csrc/fast_hadamard_transform.o: compile /home/vipuser/infinitensor-2026/hadamard-cuda-a100/fast-hadamard-transform/csrc/fast_hadamard_transform.cpp
build /home/vipuser/infinitensor-2026/hadamard-cuda-a100/fast-hadamard-transform/build/temp.linux-x86_64-cpython-312/csrc/fast_hadamard_transform_cuda.o: cuda_compile /home/vipuser/infinitensor-2026/hadamard-cuda-a100/fast-hadamard-transform/csrc/fast_hadamard_transform_cuda.cu






